#!/bin/sh
### BEGIN INIT INFO
# Provides:          forgectrl
# Required-Start:    $network $syslog
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: ForgeFIRM control daemon (camera MJPEG service)
### END INIT INFO

DAEMON=/usr/bin/forgectrl
PIDFILE=/var/run/forgectrl.pid
FIFO=/var/run/forgectrl.stderr

# The daemon runs under a small respawn wrapper: forgectrl supervises
# the motion controllers and holds the pulse-device broker, so a crash
# must not leave the machine unmanaged. A crashed forgectrl leaves any
# running controller alive (it finishes its job unmanaged); the
# respawned daemon stands by and retakes supervision when the machine
# is idle. Stopping the service stops the wrapper and the daemon both.
#
# Logging: the daemon emits through syslog itself (rsyslog files it
# under /data/log/forgefirm/forgectrl). Anything that still reaches its
# stdout/stderr - a loader error, a helper's output, an abort message -
# flows through a fifo into a `logger` relay under the same program
# name. The relay holds the fifo open read-write so it never sees EOF
# and survives daemon respawns.

case "$1" in
  start)
    echo "Starting forgectrl"
    rm -f "$FIFO"
    mkfifo -m 600 "$FIFO"
    start-stop-daemon -S -q -p $PIDFILE -m -b -x /bin/sh -- -c "
      trap 'kill \$CHILD \$RELAY 2>/dev/null; exit 0' TERM
      # The wrapper must survive memory pressure to respawn the daemon
      # (the daemon itself runs at -900, controllers at -500).
      echo -1000 > /proc/self/oom_score_adj 2>/dev/null
      logger -t forgectrl -p daemon.warning <> $FIFO &
      RELAY=\$!
      while :; do
        $DAEMON > $FIFO 2>&1 &
        CHILD=\$!
        wait \$CHILD
        RC=\$?
        [ \$RC -eq 0 ] && { kill \$RELAY 2>/dev/null; exit 0; }
        logger -t forgectrl -p daemon.err \"exited (\$RC) - respawning in 5 s\"
        sleep 5 &
        CHILD=\$!
        wait \$CHILD
      done"
    ;;
  stop)
    echo "Stopping forgectrl"
    start-stop-daemon -K -q -p $PIDFILE
    # Catch a daemon orphaned by a dead wrapper. Match the actual
    # executable, never the process name: this script - and the parent
    # shell of a "restart", which runs stop as a child - are also named
    # forgectrl, and a name match killed the restart before it could
    # reach start. Only a process whose exe IS the daemon binary dies.
    for p in $(pidof forgectrl 2>/dev/null); do
      [ "$(readlink -f /proc/$p/exe 2>/dev/null)" = "$DAEMON" ] && \
        kill $p 2>/dev/null
    done
    rm -f $PIDFILE
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
