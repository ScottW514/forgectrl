#!/bin/sh
### BEGIN INIT INFO
# Provides:          forgectrl
# Required-Start:    $network
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: ForgeFIRM control daemon (camera MJPEG service)
### END INIT INFO

DAEMON=/usr/bin/forgectrl
PIDFILE=/var/run/forgectrl.pid
LOG=/data/forgectrl.log

# The daemon runs under a small respawn wrapper: forgectrl supervises
# the motion controllers and holds the pulse-device broker, so a crash
# must not leave the machine unmanaged. A crashed forgectrl leaves any
# running controller alive (it finishes its job unmanaged); the
# respawned daemon stands by and retakes supervision when the machine
# is idle. Stopping the service stops the wrapper and the daemon both.

case "$1" in
  start)
    echo "Starting forgectrl"
    start-stop-daemon -S -q -p $PIDFILE -m -b -x /bin/sh -- -c "
      trap 'kill \$CHILD 2>/dev/null; exit 0' TERM
      # The wrapper must survive memory pressure to respawn the daemon
      # (the daemon itself runs at -900, controllers at -500).
      echo -1000 > /proc/self/oom_score_adj 2>/dev/null
      while :; do
        $DAEMON >> $LOG 2>&1 &
        CHILD=\$!
        wait \$CHILD
        RC=\$?
        [ \$RC -eq 0 ] && exit 0
        echo \"forgectrl: exited (\$RC) - respawning in 5 s\" >> $LOG
        sleep 5 &
        CHILD=\$!
        wait \$CHILD
      done"
    ;;
  stop)
    echo "Stopping forgectrl"
    start-stop-daemon -K -q -p $PIDFILE
    # Catch a daemon orphaned by a dead wrapper. A shell script's process
    # name is its own basename, so this must skip this very script - a
    # blind name match would terminate it and "restart" would never start.
    for p in $(pidof forgectrl 2>/dev/null); do
      [ "$p" = "$$" ] || kill $p 2>/dev/null
    done
    rm -f $PIDFILE
    ;;
  restart)
    $0 stop
    sleep 1
    $0 start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
