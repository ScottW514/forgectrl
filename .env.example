# Machine for the panel dev server (tools/devserver.py) and the bench
# tools. Copy to .env (git-ignored) and fill in; the dev server re-reads
# .env whenever it changes.
#
# Address of the machine running forgectrl, IP literal (the daemon
# refuses DNS names in Host), with :port if not 8080.
GF_HOST=192.168.1.50
#
# The panel bearer token: on the machine, `cat /data/forgefirm/panel.token`
# (32 hex digits). Without it the panel loads and reads live data, but
# every state-changing call is refused with 403.
GF_TOKEN=
